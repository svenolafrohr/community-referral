{
  "name": "community-referral",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend"],
  "scripts": {
    "dev": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "lint": "npm run lint --workspace frontend",
    "test": "npm run test --workspace frontend",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:migration": "supabase db schema declarative sync --no-apply --experimental --strict-coverage --name",
    "db:reset": "supabase db reset",
    "functions:serve": "supabase functions serve"
  },
  "devDependencies": {
    "supabase": "2.115.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
